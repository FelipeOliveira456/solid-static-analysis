# Maven / build
target/
*.class

# JARs (build output; keep Maven wrapper jar if added later)
*.jar
!.mvn/wrapper/maven-wrapper.jar

# IDE / OS
.idea/
*.iml
.DS_Store
*.log

# Generated scanner output (keep directory via output/.gitkeep)
output/*.json
# CLI --all from repo root: output/<project-name>/...; external abs paths: underscore segment
output/__*/
# common benchmark output roots
output/bad-project/
output/good-project/
output/*_bad/
output/*_good/

# Never commit pipeline output nested inside benchmark trees
benchmarks/**/output/

# Speckit / Cursor tooling (not part of source tree)
.cursor/
.specify/

# Local iteration notes (not versioned)
ITERACAO.md
